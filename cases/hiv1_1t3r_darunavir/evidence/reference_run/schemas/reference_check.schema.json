{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reference_check",
  "description": "方法适用性与参考对照检查。gap 表示无参考可比，不是通过。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "check_id",
      "check_type",
      "comparator",
      "status"
    ],
    "properties": {
      "check_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "check_type": {
        "type": [
          "string",
          "null"
        ]
      },
      "scope": {
        "type": [
          "string",
          "null"
        ]
      },
      "metric_name": {
        "type": [
          "string",
          "null"
        ]
      },
      "metric_value": {
        "type": [
          "number",
          "null"
        ]
      },
      "threshold": {
        "type": [
          "number",
          "null"
        ]
      },
      "comparator": {
        "enum": [
          "le",
          "ge",
          "eq",
          "none"
        ]
      },
      "status": {
        "enum": [
          "pass",
          "fail",
          "gap",
          "not_applicable"
        ]
      },
      "source": {
        "type": [
          "string",
          "null"
        ]
      },
      "note": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
